PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/skillpath
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Dates without timezone use this timezone, including datetime-local form values.
TZ=Asia/Kolkata
# Optional: reminders are disabled until SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
